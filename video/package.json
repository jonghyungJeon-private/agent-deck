{
  "name": "agentdeck-intro-video",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=18.20.5 <23" },
  "scripts": {
    "render": "remotion render src/index.ts AgentDeckIntro out/AgentDeck-intro.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2 --muted",
    "teaser": "remotion render src/index.ts AgentDeckTeaser out/AgentDeck-teaser.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2 --muted",
    "still": "remotion still src/index.ts AgentDeckIntro out/still.png --frame=600",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.365",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.365"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.3"
  }
}
